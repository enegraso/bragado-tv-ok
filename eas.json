{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "production": {
      "autoIncrement": true
    },
    "production_tv": {
      "extends": "production",
      "env": {
        "EXPO_TV": "1"
      },
    "channel": "production"
  }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}